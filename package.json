{
  "name": "clover-lms",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "db:bootstrap-admin": "npm run db:bootstrap-admin -w backend",
    "admin:bootstrap": "npm run db:bootstrap-admin",
    "test": "npm run test --workspaces",
    "db:migrate": "npm run db:migrate -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run start:dev -w backend",
    "build:frontend": "npm run build -w frontend",
    "build:backend": "npm run build -w backend",
    "dev": "concurrently -k -n frontend,backend \"npm run dev:frontend\" \"npm run dev:backend\"",
    "build": "npm run build:frontend && npm run build:backend",
    "lint": "npm run lint --workspaces",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "overrides": {
    "@nestjs/swagger": {
      "js-yaml": "5.5.0"
    }
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "prettier": "^3.9.10"
  }
}
