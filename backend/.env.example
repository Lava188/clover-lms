PORT=3000
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
# Neon pooled connection for this developer's database branch.
DATABASE_URL=
# Required before starting the API; generate a random secret outside the codebase.
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_ISSUER=clover-lms-api
JWT_AUDIENCE=clover-lms
AUTH_REFRESH_EXPIRES_IN=7d
AUTH_COOKIE_NAME=clover_refresh
# Omit this variable for automatic true in production; never use false in production.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_PATH=/api/auth
AUTH_STUDENT_ORIGIN=http://localhost:5173
AUTH_ADMIN_ORIGIN=http://localhost:5174
# Local Swagger uses the Student cookie context. Set empty to disable.
AUTH_DOCS_ORIGIN=http://localhost:3000
