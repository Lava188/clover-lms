generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "cjs"
}
datasource db {
  provider = "postgresql"
}
enum Role {
  ADMIN
  TEACHER
  STUDENT
}
model User {
  id String @id @default(uuid())
  email String @unique
  passwordHash String
  fullName String
  role Role @default(STUDENT)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
