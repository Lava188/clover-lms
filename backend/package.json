{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "admin:bootstrap": "npm run build && node --env-file-if-exists=.env dist/bootstrap-admin.js",
    "test": "npm run build && node --test test/*.test.cjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "lint": "eslint ."
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.8",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.7",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.2"
  }
}
